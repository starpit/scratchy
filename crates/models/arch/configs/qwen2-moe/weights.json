{
  "embed_tokens": [
    "vocab_size",
    "hidden_size"
  ],
  "input_layernorm": [
    "hidden_size"
  ],
  "lm_head": [
    "hidden_size",
    "vocab_size"
  ],
  "norm": [
    "hidden_size"
  ],
  "post_attention_layernorm": [
    "hidden_size"
  ],
  "self_attn.k_proj": [
    "hidden_size",
    "head_dim * num_key_value_heads"
  ],
  "self_attn.k_proj.bias": [
    "head_dim * num_key_value_heads"
  ],
  "self_attn.o_proj": [
    "head_dim * num_attention_heads",
    "hidden_size"
  ],
  "self_attn.q_proj": [
    "hidden_size",
    "head_dim * num_attention_heads"
  ],
  "self_attn.q_proj.bias": [
    "head_dim * num_attention_heads"
  ],
  "self_attn.v_proj": [
    "hidden_size",
    "head_dim * num_key_value_heads"
  ],
  "self_attn.v_proj.bias": [
    "head_dim * num_key_value_heads"
  ],

  "__bundles__": {
    "mlp": {
      "kind": "gated_shared_experts",
      "router": ["hidden_size", "num_experts"],
      "gate": ["num_experts", "hidden_size", "moe_intermediate_size"],
      "up": ["num_experts", "hidden_size", "moe_intermediate_size"],
      "down": ["num_experts", "moe_intermediate_size", "hidden_size"],
      "shared_gate": ["hidden_size", "shared_expert_intermediate_size"],
      "shared_up": ["hidden_size", "shared_expert_intermediate_size"],
      "shared_down": ["shared_expert_intermediate_size", "hidden_size"],
      "shared_scale": ["hidden_size", "1"]
    }
  }
}
