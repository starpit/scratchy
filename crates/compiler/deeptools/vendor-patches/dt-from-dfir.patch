+      if (!debug_dir.empty())
+        pm.addPass(createDumpIrPass(debug_dir, "ktir.mlir"));
+      scheduler::EnsureDeviceDeclarationPassOptions device_options;
+      device_options.deviceFileName = dbo_options.device_file.empty()
+                                          ? defaultDeviceFile()
+                                          : dbo_options.device_file;
+      pm.addPass(scheduler::createEnsureDeviceDeclarationPass(device_options));
+      scheduler::buildKTDPToDFIRPipeline(
+          pm, scheduler::SchedulerExtContext::dummyContext());
+      // The DataflowIR is consumed in-process, so it is only written out to be
