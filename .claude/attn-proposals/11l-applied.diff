+        let arena: &'static Arena = Arena::global();
+        let shape = |op: Operation<'static>, r: i64, c: i64| {
+            op.with_attr(arena, AttrKey::Shape, Attr::IntList(arena.ints(vec![r, c])))
+                .with_attr(arena, AttrKey::Dtype, Attr::Dtype(DType::F16))
