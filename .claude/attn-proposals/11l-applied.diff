+    }
+
+    #[test]
+    fn a_body_whose_seam_leaks_a_staging_refuses_the_split() {
+        let mut rolled = seam_roll();
+        // The leak op is built BEFORE mutating (borrow order): B reads A's STAGING t2
+        // instead of the seam t4, so the cross set is {t2} ≠ {t4} and the split refuses.
+        let leak_prog = seam_program(2, 20, 6, "split_leak");
+        let mut syms = 0i64;
+        let mut lowered = ktir_superdsc::emit::whole_function::lower_function(
+            &leak_prog,
+            Some(&rolled.layout),
+            &mut syms,
+            None,
+        )
+        .expect("the fixture lowers the leak program");
+        assert_eq!(
+            lowered.len(),
+            1,
+            "the seam fixture's program must lower to exactly ONE fused op — a fixture \
+             whose shape drifted FAILS, never quietly adapts"
+        );
+        let mut leak = lowered.remove(0);
+        leak.ktir = Some(leak_prog.clone());
+        leak.time = 30_000;
+        rolled.bodies[0].ops[2] = leak;
+        split_bodies_at_trip_wall(&mut rolled).expect("the conservative refusal returns Ok");
+        assert_eq!(rolled.bodies.len(), 1, "the roll is left exactly as walked");
+        assert_eq!(
+            rolled.launches,
+            vec![(0u8, 0u32), (0u8, 1u32)],
+            "the conservative refusal leaves the launch sequence untouched"
+        );
+        assert_eq!(
+            rolled.launch_w,
+            vec![(0u8, 0u64), (0u8, 1024u64)],
+            "the conservative refusal leaves the launch rows untouched"
+        );
+    }
+
+    #[test]
+    fn a_body_under_the_wall_passes_through_untouched() {
+        let mut rolled = seam_roll();
+        for op in &mut rolled.bodies[0].ops {
+            op.time = 1;
+        }
+        split_bodies_at_trip_wall(&mut rolled).expect("the no-op path returns Ok");
+        assert_eq!(rolled.bodies.len(), 1, "nothing mutates under the wall");
+        assert_eq!(
+            rolled.launches,
+            vec![(0u8, 0u32), (0u8, 1u32)],
+            "the no-op path leaves the launch sequence untouched"
+        );
+        assert_eq!(
+            rolled.launch_w,
+            vec![(0u8, 0u64), (0u8, 1024u64)],
+            "the no-op path leaves the launch rows untouched"
+        );
+        assert_eq!(rolled.launch_kv, vec![0u64, 0]);
+    }
+}
