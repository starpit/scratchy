+    }
+    let folds = SdscFoldSet::new(spec.iter.cores_used());
+    emit_sdsc_tiled(
+        &format!("{out}_fq_mm_narrow_op"),
+        &spec,
+        &folds,
+        sym_id_base,
+        layout,
+    )
+}
