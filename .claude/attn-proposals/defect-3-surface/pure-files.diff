+        for o in ops.iter().filter(|o| o.op_name.starts_with("t10_fq_mm_t")) {
+            assert!(
+                o.arg_bindings
+                    .iter()
+                    .any(|b| b.is_input && b.buffer.contains("fq_afp8t")),
+                "{}: the tile mm binds the tile's own staged afp8",
+                o.op_name
+            );
+        }
