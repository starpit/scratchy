+            *clone_sz,
+            4u64 * k as u64 * 2,
+            "tile 0's clone owns [4, k] fp16"
+        );
+        let afp8_sz = s
+            .sizes
+            .get(&a7.synth_tiled(SynthRole::FqAfp8, 0).to_string())
+            .expect("the tile afp8 is placed");
+        assert_eq!(
