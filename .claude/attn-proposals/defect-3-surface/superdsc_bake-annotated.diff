+    /// ⭐ THE LADDER'S TOTAL-WORK DECISION, EXTRACTED PURE — every stageable rung's trips in
+    /// ASCENDING width order against [`Self::MAX_TOTAL_TRIPS`], answered as how many rungs
+    /// the bake KEEPS: the kept prefix, and the refused tail behind the returned count. The
+    /// commit loop walks the same `>` law one rung at a time — a rung landing exactly AT the
+    /// ceiling is lawful, the first rung past it refuses, and every later rung is wider and
+    /// costs more, so the tail goes with it — and this is that arithmetic stated once, so
+    /// the boundary is pinned where it is decided rather than re-derived at each caller.
+    pub fn total_budget_kept_rungs(trips: &[u64]) -> usize {
+        let mut total: u64 = 0;
+        trips
+            .iter()
+            .position(|&t| {
