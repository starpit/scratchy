+    /// The extracted ladder decision: rung trips in ASCENDING width order against
+    /// [`BakeBudget::MAX_TOTAL_TRIPS`], answered as the KEPT PREFIX. Exactly-at-ceiling is
+    /// lawful (the `>` law), the first rung past the ceiling refuses, and every later rung
+    /// is wider and costs more — so the tail behind the first refusal is refused with it
+    /// even where the arithmetic alone would let a narrow late rung fit.
+    #[test]
+    fn the_total_budget_keeps_the_prefix_and_refuses_the_tail_with_the_first_over() {
+        let ceil = BakeBudget::MAX_TOTAL_TRIPS;
+        // An empty ladder keeps nothing.
+        assert_eq!(BakeBudget::total_budget_kept_rungs(&[]), 0);
+        // Everything under: all kept.
+        assert_eq!(
+            BakeBudget::total_budget_kept_rungs(&[1, 2, 3]),
+            3,
+            "a ladder well under the ceiling keeps every rung"
+        );
+        // Landing exactly AT the ceiling on the last rung is lawful — the `>` law.
+        assert_eq!(
+            BakeBudget::total_budget_kept_rungs(&[ceil / 2, ceil - ceil / 2]),
+            2,
+            "a ladder landing exactly AT the ceiling is lawful"
+        );
+        // One past on the last rung refuses exactly that rung.
+        assert_eq!(
+            BakeBudget::total_budget_kept_rungs(&[ceil / 2, ceil - ceil / 2 + 1]),
+            1,
+            "the first rung past the ceiling refuses"
+        );
+        // A single rung over the whole ceiling refuses alone.
+        assert_eq!(
+            BakeBudget::total_budget_kept_rungs(&[ceil + 1]),
+            0,
+            "one rung past the whole ceiling keeps nothing"
+        );
+        // The tail goes with the first refusal: rung 2 blows the total, and rung 3 —
+        // narrower than rung 2 in this fixture's arithmetic — is refused WITH it, because
+        // the real ladder is ascending and a rung after a wider refused one is wider still.
+        assert_eq!(
+            BakeBudget::total_budget_kept_rungs(&[ceil / 3, ceil, 1]),
+            1,
+            "every rung after the first refusal is refused with it"
+        );
+    }
