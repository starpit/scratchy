+    /// ⛔ THE TOTAL BOUNDARY IS `>`, NOT `>=` — a bake landing exactly AT 92,000 trips is
+    /// lawful (the ceiling is sized to the 600 s law, and a bake that meets its law exactly
+    /// has not blown it), one trip past it refuses naming the measured total and the
+    /// ceiling, and the refusal is a [`BudgetRefusal`] — the class a rung survives.
+    #[test]
+    fn a_total_at_the_ceiling_passes_and_one_past_it_refuses_naming_both() {
+        let at = BakeBudget::MAX_TOTAL_TRIPS;
+        assert!(
+            BakeBudget::total_verdict(at).is_ok(),
+            "a bake that lands exactly AT the total ceiling is lawful"
+        );
+        let err = BakeBudget::total_verdict(at + 1).unwrap_err().0;
+        assert!(
+            err.contains(&format!("{} trips over the whole bake", at + 1)),
+            "must name the measured total: {err}"
+        );
+        assert!(
+            err.contains(&format!("of {at} trips per model")),
+            "must name the ceiling: {err}"
+        );
