+                 a total past it is the bake's floor blowing up, which no parallelism \
+                 recovers. Moving the budget is a measured decision that names the bake; this \
+                 refusal is the measurement.",
+                Self::MAX_TOTAL_TRIPS,
+            ));
+        }
+        Ok(())
+    }
