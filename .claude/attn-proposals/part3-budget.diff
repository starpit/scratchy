+    pub const MAX_TOTAL_TRIPS: u64 = 92_000;
+
+    /// The per-MODEL total-trips verdict — the sum over every body class's minted trips
+    /// (the arithmetic [`crate::lower_subtile_tape_to_ktir::mint_trips`] already runs per
